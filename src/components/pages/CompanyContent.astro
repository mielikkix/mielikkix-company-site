---
import Panel from '../Panel.astro';
import Eyebrow from '../Eyebrow.astro';
import Glow from '../Glow.astro';
import IconBadge from '../IconBadge.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).company;
---

<div class="mx-auto max-w-6xl space-y-6 px-4 py-12 sm:space-y-8 sm:px-6 sm:py-16 lg:px-8">
  <Panel tone="gold" class="relative overflow-hidden">
    <Glow class="-right-16 -top-24 h-72 w-72" tone="gold" />
    <div class="relative max-w-2xl">
      <Eyebrow text={c.eyebrow} tone="gold" />
      <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">{c.heading}</h1>
    </div>
  </Panel>

  <Panel id="about" class="scroll-mt-24">
    <div class="flex items-center gap-4">
      <IconBadge icon="target" tone="accent" />
      <h2 class="text-2xl font-bold sm:text-3xl">{c.aboutHeading}</h2>
    </div>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-white/80">{c.aboutBody}</p>
  </Panel>

  <Panel id="careers" class="scroll-mt-24">
    <div class="flex items-center gap-4">
      <IconBadge icon="trendingUp" tone="gold" />
      <h2 class="text-2xl font-bold sm:text-3xl">{c.careersHeading}</h2>
    </div>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-white/80">{c.careersBody}</p>
  </Panel>

  <Panel id="contact" class="scroll-mt-24">
    <div class="flex items-center gap-4">
      <IconBadge icon="headset" tone="accent" />
      <h2 class="text-2xl font-bold sm:text-3xl">{c.contactHeading}</h2>
    </div>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-white/80">{c.contactBody}</p>
  </Panel>
</div>
