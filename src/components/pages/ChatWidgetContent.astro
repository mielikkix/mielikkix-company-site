---
import ButtonPrimary from '../ButtonPrimary.astro';
import Card from '../Card.astro';
import Panel from '../Panel.astro';
import Eyebrow from '../Eyebrow.astro';
import Glow from '../Glow.astro';
import IconBadge from '../IconBadge.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).chatWidget;
const capabilityIcons: ('clock' | 'route' | 'target' | 'code')[] = ['clock', 'route', 'target', 'code'];
---

<div class="mx-auto max-w-6xl space-y-6 px-4 py-12 sm:space-y-8 sm:px-6 sm:py-16 lg:px-8">
  <Panel surface="dark" tone="accent" class="relative overflow-hidden">
    <Glow class="-right-16 -top-24 h-72 w-72" tone="accent" />
    <div class="relative max-w-2xl">
      <Eyebrow text={c.eyebrow} tone="accent" />
      <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">{c.heading}</h1>
      <p class="mt-6 text-lg leading-relaxed text-mist-white/80">{c.subhead}</p>
    </div>
  </Panel>

  <Panel>
    <h2 class="text-2xl font-bold text-deep-forest sm:text-3xl">{c.whatHeading}</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-deep-forest/70">{c.whatBody}</p>
  </Panel>

  <Panel>
    <h2 class="text-2xl font-bold text-deep-forest sm:text-3xl">{c.capabilitiesHeading}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        c.capabilities.map((cap, i) => (
          <Card>
            <IconBadge icon={capabilityIcons[i]} tone={i % 2 === 0 ? 'accent' : 'gold'} />
            <h3 class="mt-4 text-lg font-semibold text-deep-forest">{cap.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-deep-forest/70">{cap.body}</p>
          </Card>
        ))
      }
    </div>
  </Panel>

  <Panel surface="dark" tone="gold" class="text-center">
    <h2 class="text-2xl font-bold sm:text-3xl">{c.ctaHeading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-mist-white/80">{c.ctaBody}</p>
    <div class="mt-8 flex justify-center">
      <ButtonPrimary href="https://app.mielikkix.ai">{c.cta}</ButtonPrimary>
    </div>
  </Panel>
</div>
