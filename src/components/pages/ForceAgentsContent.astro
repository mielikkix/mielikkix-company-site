---
import ButtonPrimary from '../ButtonPrimary.astro';
import Card from '../Card.astro';
import Panel from '../Panel.astro';
import Eyebrow from '../Eyebrow.astro';
import Glow from '../Glow.astro';
import IconBadge from '../IconBadge.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).forceAgents;
const groups = [c.groups.frontDesk, c.groups.salesMarketing, c.groups.growthRetention];
const panelTones = ['accent', 'gold', 'default'] as const;
const iconTones = ['accent', 'gold', 'mixed'] as const;
const groupIcons = ['headset', 'megaphone', 'trendingUp'] as const;
---

<div class="mx-auto max-w-6xl space-y-6 px-4 py-12 sm:space-y-8 sm:px-6 sm:py-16 lg:px-8">
  <Panel tone="gold" class="relative overflow-hidden">
    <Glow class="-right-16 -top-24 h-72 w-72" tone="gold" />
    <div class="relative max-w-2xl">
      <Eyebrow text={c.eyebrow} tone="gold" />
      <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">{c.heading}</h1>
      <p class="mt-6 text-lg leading-relaxed text-mist-white/80">{c.subhead}</p>
    </div>
  </Panel>

  {
    groups.map((group, i) => (
      <Panel tone={panelTones[i]}>
        <div class="flex items-center gap-4">
          <IconBadge icon={groupIcons[i]} tone={iconTones[i]} />
          <h2 class="text-2xl font-bold sm:text-3xl">{group.heading}</h2>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.agents.map((agent) => (
            <Card title={agent.name}>
              <p class="text-sm leading-relaxed text-mist-white/80">{agent.body}</p>
            </Card>
          ))}
        </div>
      </Panel>
    ))
  }

  <Panel class="text-center">
    <h2 class="text-2xl font-bold sm:text-3xl">{c.closingHeading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-mist-white/80">{c.closingBody}</p>
    <div class="mt-8 flex justify-center">
      <ButtonPrimary href="https://app.mielikkix.ai">{c.closingCta}</ButtonPrimary>
    </div>
  </Panel>
</div>
