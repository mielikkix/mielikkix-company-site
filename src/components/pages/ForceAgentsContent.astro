---
import ButtonPrimary from '../ButtonPrimary.astro';
import Card from '../Card.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).forceAgents;
const groups = [c.groups.frontDesk, c.groups.salesMarketing, c.groups.growthRetention];
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
  <p class="text-sm font-semibold uppercase tracking-widest text-aurora-neon">{c.eyebrow}</p>
  <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{c.heading}</h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist-white/80">{c.subhead}</p>
</section>

{
  groups.map((group) => (
    <section class="border-t border-mist-white/10">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold sm:text-3xl">{group.heading}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.agents.map((agent) => (
            <Card title={agent.name}>
              <p class="text-sm leading-relaxed text-mist-white/80">{agent.body}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  ))
}

<section class="border-t border-mist-white/10">
  <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
    <h2 class="text-2xl font-bold sm:text-3xl">{c.closingHeading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-mist-white/80">{c.closingBody}</p>
    <div class="mt-8 flex justify-center">
      <ButtonPrimary href="https://app.mielikkix.ai">{c.closingCta}</ButtonPrimary>
    </div>
  </div>
</section>
