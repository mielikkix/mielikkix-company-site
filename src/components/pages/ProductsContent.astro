---
import ButtonPrimary from '../ButtonPrimary.astro';
import Panel from '../Panel.astro';
import Card from '../Card.astro';
import Eyebrow from '../Eyebrow.astro';
import Glow from '../Glow.astro';
import IconBadge from '../IconBadge.astro';
import { t } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang).products;
---

<div class="mx-auto max-w-6xl space-y-6 px-4 py-12 sm:space-y-8 sm:px-6 sm:py-16 lg:px-8">
  <Panel tone="gold" class="relative overflow-hidden text-center">
    <Glow class="-left-24 -top-24 h-72 w-72" tone="gold" />
    <Glow class="-right-24 -top-24 h-72 w-72" tone="accent" />
    <div class="relative mx-auto max-w-3xl">
      <Eyebrow text={c.eyebrow} tone="gold" class="mx-auto" />
      <h1 class="mt-5 text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">{c.heading}</h1>
      <p class="mt-6 text-lg leading-relaxed text-mist-white/80">{c.subhead}</p>
    </div>
  </Panel>

  <Panel>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        c.categories.map((category) => (
          <Card>
            <IconBadge icon={category.icon} tone="accent" />
            <h3 class="mt-4 text-lg font-semibold text-mist-white">{category.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist-white/75">{category.body}</p>
          </Card>
        ))
      }
    </div>
  </Panel>

  <Panel tone="accent" class="text-center">
    <h2 class="text-2xl font-bold sm:text-3xl">{c.ctaBody}</h2>
    <div class="mt-8 flex justify-center">
      <ButtonPrimary href="https://mielikkix.ai">{c.cta}</ButtonPrimary>
    </div>
  </Panel>
</div>
