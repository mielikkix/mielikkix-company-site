---
interface Props {
  withoutHeading: string;
  withoutList: string[];
  withHeading: string;
  withList: string[];
  class?: string;
}

const { withoutHeading, withoutList, withHeading, withList, class: className = '' } = Astro.props;
---

<div class={`grid gap-6 pb-6 sm:pb-8 md:grid-cols-2 md:gap-0 md:pb-10 ${className}`}>
  <div class="rounded-3xl border border-mist-white/20 bg-mist-white p-8 sm:p-10 md:mr-[-1.5rem] md:mt-8 md:pr-16">
    <h3 class="text-2xl font-bold text-deep-forest">{withoutHeading}</h3>
    <ul class="mt-6 space-y-5">
      {
        withoutList.map((item, i) => (
          <li class={`flex items-start gap-3 text-deep-forest/80 ${i < withoutList.length - 1 ? 'border-b border-deep-forest/10 pb-5' : ''}`}>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-deep-forest/30 text-deep-forest">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-base leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="relative z-10 rounded-3xl border border-aurora-neon/30 bg-deep-forest p-8 shadow-xl shadow-black/40 sm:p-10 md:ml-[-1.5rem]">
    <h3 class="text-2xl font-bold text-aurora-neon">{withHeading}</h3>
    <ul class="mt-6 space-y-5">
      {
        withList.map((item, i) => (
          <li class={`flex items-start gap-3 text-mist-white/85 ${i < withList.length - 1 ? 'border-b border-mist-white/10 pb-5' : ''}`}>
            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-aurora-neon/40 text-aurora-neon">
              <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-base leading-relaxed">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
