---
import IconBadge from './IconBadge.astro';
import type { IconName } from '../i18n/ui';

interface Props {
  icon: IconName;
  name: string;
  description: string;
  cta: string;
  class?: string;
}

const { icon, name, description, cta, class: className = '' } = Astro.props;
---

<div class={`flex h-full flex-col rounded-2xl border border-mist-white/15 bg-mist-white/[0.03] p-6 ${className}`}>
  <IconBadge icon={icon} tone="accent" />
  <h3 class="mt-4 text-lg font-semibold text-mist-white">{name}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-mist-white/75">{description}</p>
  <a
    href="https://mielikkix.ai"
    target="_blank"
    rel="noopener"
    class="mt-5 inline-flex items-center justify-center gap-1 rounded-full border border-aurora-neon px-5 py-2.5 text-sm font-semibold text-aurora-neon transition hover:bg-aurora-neon/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white"
  >
    {cta}
    <span aria-hidden="true">→</span>
  </a>
</div>
