---
interface Props {
  class?: string;
  id?: string;
  tone?: 'default' | 'accent' | 'gold';
  surface?: 'light' | 'dark';
}

const { class: className = '', id, tone = 'default', surface = 'light' } = Astro.props;

const lightTone: Record<NonNullable<Props['tone']>, string> = {
  default: 'border-antler-gold/20 bg-white shadow-md shadow-deep-forest/5',
  accent: 'border-aurora-neon/30 bg-aurora-neon/5 shadow-md shadow-deep-forest/5',
  gold: 'border-antler-gold/30 bg-antler-gold/5 shadow-md shadow-deep-forest/5',
};

const darkTone: Record<NonNullable<Props['tone']>, string> = {
  default: 'border-mist-white/10 bg-deep-forest text-mist-white shadow-lg shadow-black/20',
  accent: 'border-aurora-neon/25 bg-deep-forest text-mist-white shadow-lg shadow-black/20',
  gold: 'border-antler-gold/25 bg-deep-forest text-mist-white shadow-lg shadow-black/20',
};

const toneClasses = surface === 'dark' ? darkTone[tone] : lightTone[tone];
---

<div id={id} class={`rounded-3xl border ${toneClasses} p-8 sm:p-10 ${className}`}>
  <slot />
</div>
