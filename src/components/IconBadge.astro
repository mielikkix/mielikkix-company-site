---
import Icon from './Icon.astro';

interface Props {
  icon: Parameters<typeof Icon>[0]['name'];
  tone?: 'accent' | 'gold' | 'mixed';
  class?: string;
}

const { icon, tone = 'accent', class: className = '' } = Astro.props;

const toneClasses = {
  accent: 'bg-gradient-to-br from-aurora-neon/25 to-deep-forest text-aurora-neon border-aurora-neon/30',
  gold: 'bg-gradient-to-br from-antler-gold/25 to-deep-forest text-antler-gold border-antler-gold/30',
  mixed: 'bg-gradient-to-br from-aurora-neon/20 to-antler-gold/20 text-mist-white border-mist-white/20',
};
---

<div class={`inline-flex h-11 w-11 items-center justify-center rounded-2xl border ${toneClasses[tone]} ${className}`}>
  <Icon name={icon} class="h-5 w-5" />
</div>
