---
import Icon from './Icon.astro';

interface Node {
  icon: Parameters<typeof Icon>[0]['name'];
  label: string;
  tone: 'accent' | 'gold';
}

interface Props {
  centerLabel: string;
  nodes: [Node, Node, Node];
}

const { centerLabel, nodes } = Astro.props;

// Percentage positions on a square canvas: top, bottom-left, bottom-right.
const positions = [
  { top: '6%', left: '50%' },
  { top: '82%', left: '14%' },
  { top: '82%', left: '86%' },
];

const toneText = { accent: 'text-aurora-neon border-aurora-neon/40 bg-deep-forest', gold: 'text-antler-gold border-antler-gold/40 bg-deep-forest' };
---

<div class="relative mx-auto aspect-square w-full max-w-sm">
  <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full" aria-hidden="true">
    <line x1="100" y1="100" x2="100" y2="24" stroke="currentColor" class="text-deep-forest/20" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="100" y1="100" x2="42" y2="158" stroke="currentColor" class="text-deep-forest/20" stroke-width="1.5" stroke-dasharray="4 4" />
    <line x1="100" y1="100" x2="158" y2="158" stroke="currentColor" class="text-deep-forest/20" stroke-width="1.5" stroke-dasharray="4 4" />
  </svg>

  <div class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center gap-1 rounded-full border border-aurora-neon/40 bg-deep-forest text-center shadow-lg shadow-black/30">
    <Icon name="chat" class="h-5 w-5 text-aurora-neon" />
    <span class="text-[10px] font-semibold leading-tight text-mist-white">{centerLabel}</span>
  </div>

  {
    nodes.map((node, i) => (
      <div
        class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-1.5 text-center"
        style={{ top: positions[i].top, left: positions[i].left }}
      >
        <span class={`flex h-12 w-12 items-center justify-center rounded-full border ${toneText[node.tone]}`}>
          <Icon name={node.icon} class="h-5 w-5" />
        </span>
        <span class="max-w-[6.5rem] text-[11px] font-medium leading-tight text-deep-forest/70">{node.label}</span>
      </div>
    ))
  }
</div>
