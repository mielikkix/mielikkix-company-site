---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center justify-center rounded-full bg-aurora-neon px-6 py-3 text-sm font-semibold text-[#06231A] transition hover:scale-105 hover:shadow-[0_0_24px_rgba(0,229,160,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white ${className}`}
>
  <slot />
</a>
