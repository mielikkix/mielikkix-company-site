---
import BrandMark from './BrandMark.astro';
import ButtonPrimary from './ButtonPrimary.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localizedPath, getRouteSlug } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const nav = t(lang).nav;
const currentSlug = getRouteSlug(path);

const links = [
  { slug: '/solutions', label: nav.solutions },
  { slug: '/products', label: nav.products },
  { slug: '/industries', label: nav.industries },
  { slug: '/security', label: nav.security },
  { slug: '/company', label: nav.company },
];
---

<header class="sticky top-0 z-50 border-b border-mist-white/10 bg-deep-forest/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a
      href={localizedPath('/', lang)}
      class="flex items-center gap-2 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white"
    >
      <BrandMark class="h-9 w-9" />
      <span class="text-lg font-bold tracking-tight text-mist-white">Mielikki<span class="text-aurora-neon">X</span></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <label
      for="nav-toggle"
      class="cursor-pointer rounded p-2 text-mist-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white lg:hidden"
      aria-label={nav.menuLabel}
      tabindex="0"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </label>

    <div
      class="absolute inset-x-0 top-full hidden flex-col gap-4 border-b border-mist-white/10 bg-deep-forest px-4 py-4 peer-checked:flex sm:px-6 lg:static lg:flex lg:flex-1 lg:flex-row lg:items-center lg:justify-between lg:border-none lg:p-0"
    >
      <ul class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-5">
        {
          links.map((link) => {
            const href = localizedPath(link.slug, lang);
            const isActive = currentSlug === link.slug;
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`rounded text-sm font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white ${
                    isActive ? 'text-aurora-neon' : 'text-mist-white/85 hover:text-mist-white'
                  }`}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex flex-wrap items-center gap-4">
        <LanguageSwitcher lang={lang} path={path} />
        <a
          href="https://app.mielikkix.ai"
          class="hidden rounded text-sm font-medium text-mist-white/80 transition hover:text-mist-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mist-white sm:inline-flex"
        >
          {nav.login}
        </a>
        <ButtonPrimary href={`${localizedPath('/company', lang)}#demo`} class="!px-5 !py-2.5">
          {nav.bookDemo}
        </ButtonPrimary>
      </div>
    </div>
  </div>
</header>
