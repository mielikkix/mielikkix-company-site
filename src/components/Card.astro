---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div
  class={`rounded-2xl border border-antler-gold/25 bg-white p-6 shadow-sm transition hover:border-antler-gold/60 hover:shadow-md ${className}`}
>
  {title && <h3 class="mb-2 text-lg font-semibold text-deep-forest">{title}</h3>}
  <slot />
</div>
